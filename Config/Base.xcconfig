// Shared build settings for every target.

#include "Signing.xcconfig"

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES
SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
STRING_CATALOG_GENERATE_SYMBOLS = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_STRICT_OBJC_MSGSEND = YES
ALWAYS_SEARCH_USER_PATHS = NO
CLANG_ENABLE_MODULES = YES
CLANG_ENABLE_OBJC_ARC = YES
CODE_SIGN_STYLE = Automatic
CURRENT_PROJECT_VERSION = 1
MARKETING_VERSION = 1.0
GENERATE_INFOPLIST_FILE = YES
COPY_PHASE_STRIP = NO
DEAD_CODE_STRIPPING = YES

VAULT_APP_BUNDLE_ID = $(VAULT_BUNDLE_ID_PREFIX).vault

VAULT_APP_GROUP_ID_YES = group.$(VAULT_APP_BUNDLE_ID)
VAULT_APP_GROUP_ID_NO =
VAULT_APP_GROUP_ID = $(VAULT_APP_GROUP_ID_$(VAULT_USE_APP_GROUP))

VAULT_CLOUDKIT_CONTAINER = iCloud.$(VAULT_APP_BUNDLE_ID)
VAULT_CLOUDKIT_CONDITION_YES = CLOUDKIT_SYNC
VAULT_CLOUDKIT_CONDITION_NO =
VAULT_APP_GROUP_CONDITION_YES = APP_GROUP
VAULT_APP_GROUP_CONDITION_NO =

SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(VAULT_CLOUDKIT_CONDITION_$(VAULT_USE_CLOUDKIT)) $(VAULT_APP_GROUP_CONDITION_$(VAULT_USE_APP_GROUP))
