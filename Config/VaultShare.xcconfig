#include "Base.xcconfig"

PRODUCT_NAME = VaultShare
PRODUCT_BUNDLE_IDENTIFIER = $(VAULT_APP_BUNDLE_ID).share
INFOPLIST_FILE = Config/VaultShare-Info.plist
CODE_SIGN_ENTITLEMENTS = Config/Entitlements/Extension.AppGroup-$(VAULT_USE_APP_GROUP).entitlements
SKIP_INSTALL = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @executable_path/../../Frameworks
INFOPLIST_KEY_CFBundleDisplayName = Save to Vault
